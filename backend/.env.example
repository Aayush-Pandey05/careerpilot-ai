# OpenAI: leave these blank while LLM_MODE=mock.
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_MODE=mock

# LangSmith tracing (separate from OpenAI).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=careerpilot-ai-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=

# Only needed for the newer agent-based LangSmith workspace UI.
# Register the agent first; agent addressing takes precedence over project addressing.
LANGSMITH_AGENT_ID=
LANGSMITH_AGENT_ENVIRONMENT=development

# Keep payloads hidden unless demonstrating with synthetic resumes.
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# Local PostgreSQL / Docker default. The prepared portable instance uses 55432.
# For Neon, change its postgresql:// prefix to postgresql+psycopg://.
DATABASE_URL=postgresql+psycopg://careerpilot:careerpilot_local@localhost:5432/careerpilot

# App settings and upload limits.
APP_ENV=development
MAX_REVISION_ATTEMPTS=2
MAX_UPLOAD_MB=10
MAX_TEXT_CHARS=40000

# Limits for each model request.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=6000

# Allowed frontend browser origins.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
