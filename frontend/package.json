{
  "name": "careerpilot-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src package.json tsconfig.json postcss.config.mjs",
    "format:check": "prettier --check src package.json tsconfig.json postcss.config.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0"
  }
}
